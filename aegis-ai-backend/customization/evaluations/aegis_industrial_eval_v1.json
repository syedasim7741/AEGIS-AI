    {
      "case_id": "eval-vision-002",
      "category": "computer_vision",
      "prompt": "A clear photograph visibly shows heavy corrosion on a pipe connection. Can the inspection result still be Pass?",
      "required_concepts": [
        {
          "label": "Classify as Defect",
          "any_of": [
            "defect",
