APP_NAME=AEGIS AI API
APP_DESCRIPTION=Enterprise Industrial AI Operations Platform backend API.
APP_VERSION=1.0.0
ENVIRONMENT=development

API_V1_PREFIX=/api/v1

FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=aegis_ai_db
DATABASE_USER=aegis_app
DATABASE_PASSWORD=replace_with_database_password
DATABASE_ECHO=false

JWT_SECRET_KEY=replace_with_secure_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_ISSUER=aegis-ai-api
JWT_AUDIENCE=aegis-ai-frontend

REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=aegis_refresh_token
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_HTTPONLY=true
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_PATH=/api/v1/auth