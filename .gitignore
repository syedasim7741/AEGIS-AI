# ============================================================
# AEGIS AI - Git Ignore Rules
# ============================================================

# Environment variables and secrets
.env
.env.*
!.env.example
!.env.*.example

# Private credentials and certificates
*.pem
*.key
*.pfx
*.p12
credentials/
secrets/
**/credentials/
**/secrets/

# Python environments and cache
.venv/
**/.venv/
venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
**/.pytest_cache/
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/
.coverage
htmlcov/

# JavaScript dependencies and builds
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
*.local

# Runtime-generated application data
backups/
**/storage/
**/customization/reports/

# Generated security reports
reports/security/*.json
**/reports/security/*.json

# Keep documented security exceptions
!reports/security/.trivyignore.yaml
!reports/security/backend-scan-exception.md

# Local backup files
*.pre-stage9-backup
*.pre-alpine-backup

# Logs
logs/
**/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and operating-system files
.vscode/*
!.vscode/extensions.json
**/.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local source backups
aegis-ai-frontend-src-backup/
